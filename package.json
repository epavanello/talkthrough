{
  "name": "talkthrough-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @talkthrough/webview build && pnpm --filter talkthrough build",
    "package": "pnpm build && pnpm --filter talkthrough package",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "e2e": "pnpm build && pnpm --filter talkthrough e2e",
    "cli-check": "pnpm --filter talkthrough cli-check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3"
  }
}
